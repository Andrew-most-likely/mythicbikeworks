# Cache rules for Cloudflare Pages (GitHub Pages ignores this file).
# CSS and JS are referenced with ?v=N; bump N in index.html and
# tools/build_pages.py whenever styles.css or main.js change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
